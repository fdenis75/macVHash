#compdef vhash

__vhash_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__vhash_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __vhash_complete "${completions[@]:0:-1}"
    fi
}

__vhash_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_vhash() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar ___hash=('phash' 'oshash' 'all')
    local -ar ___format=('table' 'csv' 'json')
    local -ar arg_specs=(
        '*:path:_files'
        '(-r --recursive)'{-r,--recursive}'[Descend into subdirectories when an input is a directory.]'
        '*'{-H,--hash}'[Hash to compute\: phash, oshash or all. Repeatable or comma-separated.]:algorithm:{__vhash_complete "${___hash[@]}"}'
        '(-j --concurrency)'{-j,--concurrency}'[Number of files hashed at the same time.]:n:'
        '--ffmpeg-path[Path to the ffmpeg executable (default\: search PATH).]:path:_files'
        '(-f --format)'{-f,--format}'[Output format\: table, csv or json. Inferred from the -o extension when omitted.]:format:{__vhash_complete "${___format[@]}"}'
        '(-o --output)'{-o,--output}'[Write results to this file instead of stdout.]:file:_files'
        '--force[Overwrite the output file if it exists.]'
        '(-q --quiet)'{-q,--quiet}'[Suppress progress and warnings (errors are still printed).]'
        '(-v --verbose)'{-v,--verbose}'[Print one line per file on stderr as it completes.]'
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        help)
            "_vhash_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

_vhash_help() {
    local -i ret=1
    local -ar arg_specs=(
        '*:subcommands:'
        '--version[Show the version.]'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0

    return "${ret}"
}

if [[ "${funcstack[1]}" = _vhash ]]; then
    _vhash "${@}"
else
    compdef _vhash vhash
fi
